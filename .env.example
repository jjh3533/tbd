# 이 파일을 복사해서 ".env" 로 저장한 뒤 실제 값을 채워 넣으세요.
# .env 파일 자체는 .gitignore에 의해 절대 git에 커밋되지 않습니다.
#
# ⚠️ 기존에 app.py / tbd_tracker.py 에 하드코딩되어 있던 아래 4개 값은
# 이미 public GitHub 레포에 커밋되어 노출된 상태입니다.
# 이 템플릿에 값을 채우기 전에 반드시 Airtable / ScraperAPI / Telegram에서
# 기존 키를 폐기(revoke)하고 새 키를 발급받아 아래에 넣으세요.

AIRTABLE_API_TOKEN=your_new_airtable_personal_access_token
AIRTABLE_BASE_ID=your_airtable_base_id
AIRTABLE_TABLE_NAME=Products

SCRAPERAPI_KEY=your_new_scraperapi_key

TELEGRAM_TOKEN=your_new_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id
