# 이 파일을 복사해서 ".env" 로 저장한 뒤 실제 값을 채워 넣으세요.
# .env 파일 자체는 .gitignore에 의해 절대 git에 커밋되지 않습니다.
#
# NOCODB_API_TOKEN은 NocoDB 우측 상단 프로필 아이콘 -> Account Settings ->
# Tokens -> Create New Token 에서 발급받으세요.
# SCRAPEDO_TOKEN은 https://scrape.do 가입 후 대시보드에서 발급받으세요.

NOCODB_URL=http://your-nocodb-host:8080
NOCODB_API_TOKEN=your_nocodb_api_token
NOCODB_TABLE_ID=your_products_table_id

SCRAPEDO_TOKEN=your_scrapedo_token

TELEGRAM_TOKEN=your_new_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# NAVER_CLIENT_ID/NAVER_CLIENT_SECRET은 apicenter.commerce.naver.com에서 발급받으세요.
NAVER_CLIENT_ID=your_naver_client_id
NAVER_CLIENT_SECRET=your_naver_client_secret
