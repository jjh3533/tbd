# 이 파일을 복사해서 ".env" 로 저장한 뒤 실제 값을 채워 넣으세요.
# .env 파일 자체는 .gitignore에 의해 절대 git에 커밋되지 않습니다.
#
# NOCODB_API_TOKEN은 NocoDB 우측 상단 프로필 아이콘 -> Account Settings ->
# Tokens -> Create New Token 에서 발급받으세요.
# SCRAPEDO_TOKEN은 https://scrape.do 가입 후 대시보드에서 발급받으세요.

NOCODB_URL=http://your-nocodb-host:8080
NOCODB_API_TOKEN=your_nocodb_api_token
NOCODB_TABLE_ID=your_products_table_id
NOCODB_HISTORY_TABLE_ID=your_price_history_table_id

SCRAPEDO_TOKEN=your_scrapedo_token

TELEGRAM_TOKEN=your_new_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# NAVER_CLIENT_ID/NAVER_CLIENT_SECRET은 apicenter.commerce.naver.com에서 발급받으세요.
# 등록 파이프라인(main.py)을 실제로 돌리지 않는 환경(예: NAS 대시보드)이면
# 비워둬도 됩니다 - naver_config.py에서 required=False로 처리함.
NAVER_CLIENT_ID=your_naver_client_id
NAVER_CLIENT_SECRET=your_naver_client_secret

# TBD_SEOUL_ROOT: Product Images/Product Pages_html이 들어있는 루트 폴더 경로
# 오버라이드. 로컬 맥에서는 비워두면 Google Drive CloudStorage 경로를 자동
# 사용하므로 보통 필요 없음. NAS(도커) 배포본만 설정 (예: /app/dev/smartstore).
TBD_SEOUL_ROOT=

# 대시보드(my.tbd.kr) 로그인 비밀번호. URL만 알면 누구나 접근 가능한 문제를
# 막기 위한 단일 관리자 비밀번호 - 로컬/NAS 각각 설정 필요 (같은 값 아니어도 됨).
DASHBOARD_PASSWORD=change_me

# 대시보드 세션 서명 키. 충분히 긴 무작위 문자열로 설정
# (예: python3 -c "import secrets; print(secrets.token_hex(32))").
# 로컬/NAS 각각 별도 값 사용 권장.
DASHBOARD_STORAGE_SECRET=change_me

# CheapSub(중계 API, https://cheapsub.im/api/dashboard에서 발급, csk_로 시작)
# - 상세페이지 브리프 초안 생성(brief_generator.py, 로컬 전용)에서만 사용.
# 비워두면 그 기능만 못 쓰고 나머지 대시보드는 정상 동작함(required=False).
CHEAPSUB_API_KEY=csk_your_key
NOCODB_ORDER_TABLE_ID=your_order_fulfillment_table_id
